# Telegram API 配置
# 在 https://my.telegram.org/apps 获取

# API ID (整数)
TG_API_ID=12345678

# API Hash (字符串)
TG_API_HASH=0123456789abcdef0123456789abcdef

# 会话名称 (可选,默认为 telegram_session)
TG_SESSION_NAME=my_telegram_session

# 会话文件存储目录 (可选,默认为 ./sessions)
TG_SESSION_DIR=./sessions

# 单次获取未读消息上限 (>=1,默认60)
TG_MAX_UNREAD_FETCH=60

# Proxy (optional)
# TG_PROXY_TYPE=socks5
# TG_PROXY_HOST=127.0.0.1
# TG_PROXY_PORT=1080
# TG_PROXY_USERNAME=
# TG_PROXY_PASSWORD=
# TG_PROXY_RDNS=true
